{
  "name": "tenemosfilo-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Tenemos Filo (Express + Prisma + Postgres)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/resolve-db-url.mjs prisma migrate dev",
    "prisma:deploy": "node scripts/resolve-db-url.mjs prisma migrate deploy",
    "prisma:studio": "node scripts/resolve-db-url.mjs prisma studio",
    "prisma:reset": "node scripts/resolve-db-url.mjs prisma migrate reset",
    "script:create-host": "tsx scripts/create-host.ts",
    "script:promote-reseller": "tsx scripts/promote-to-reseller.ts",
    "db:local:create": "createdb tenemosfilo_dev || true",
    "db:local:setup": "npm run db:local:create && DB_TARGET=local npm run prisma:deploy && npm run db:local:seed",
    "db:local:seed": "tsx scripts/seed-dev-users.ts && tsx scripts/seed-dev-data.ts",
    "db:local:seed:users": "tsx scripts/seed-dev-users.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@aws-sdk/s3-request-presigner": "^3.1046.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^9.14.2",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "eslint": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
