// Schema derivado del modelo Sanity actual de tenemosfilo-front.
// Convencion: campos de auditoria (createdAt/updatedAt/deletedAt/isActive)
// en casi todas las entidades. JSON para sub-objetos flexibles.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// NextAuth (Prisma Adapter compatible)
// Si en el futuro NextAuth usa el adapter directamente, estas
// tablas ya estan listas. Por ahora la auth la maneja el API
// y NextAuth solo firma JWT, pero las dejamos para flexibilidad.
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Dominio
// ============================================================

enum UserRole {
  HOST
  GUEST
  ADMIN
  RESELLER
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  password       String? // bcrypt hash; null si solo OAuth
  emailVerified  DateTime?
  image          String?
  role           UserRole  @default(GUEST)
  phone          String?
  documentType   String?
  documentNumber String?
  firebaseId     String?   @unique // legacy: para futura migracion desde Firebase

  // Pertenencia a una company (host o guest enlazado a una empresa)
  companyId String?
  company   Company? @relation("CompanyUsers", fields: [companyId], references: [id])

  accounts Account[]
  sessions Session[]

  // Relaciones de dominio
  ownedCompanies               Company[]            @relation("CompanyOwner")
  contactsAssigned             Contact[]            @relation("ContactAssignedTo")
  condicionesDePagoAutorizadas Opportunity[]        @relation("OpportunityPaymentCondition")
  contactsCreated              Contact[]            @relation("ContactCreatedBy")
  crmCompaniesAssigned         CrmCompany[]         @relation("CrmCompanyAssignedTo")
  opportunitiesAssigned        Opportunity[]        @relation("OpportunityAssignedTo")
  opportunitiesCreated         Opportunity[]        @relation("OpportunityCreatedBy")
  reservationsCheckedIn        Reservation[]        @relation("ReservationCheckedInBy")
  reservations                 Reservation[]
  quotes                       Quote[]              @relation("QuoteHost")
  integrations                 Integration[]
  apiKeysCreated               ApiKey[]             @relation("ApiKeyCreatedBy")
  passwordResetTokens          PasswordResetToken[]

  isActive      Boolean        @default(true)
  notifications Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}

// A quien hay que dirigirse en la empresa para cada cosa.
//
// RESERVAS y CONTABILIDAD son obligatorios y solo puede haber uno de cada:
// son cargos, no personas, y dos respuestas a "¿a quien aviso de una reserva?"
// no es una respuesta. OTRO admite hasta tres y lleva su propia etiqueta.
enum CompanyContactType {
  RESERVAS
  CONTABILIDAD
  OTRO
}

// Si el anfitrion es una persona o una empresa constituida.
//
// No es un dato descriptivo: decide que documentacion legal se le pide. Una
// persona natural no esta inscrita en Camara de Comercio, asi que pedirle ese
// certificado es pedirle algo que no existe.
enum PersonType {
  NATURAL
  JURIDICA
}

// Que clase de negocio es el anfitrion. El orden es el que se le enseña al
// elegir, con OTHER al final como salida cuando nada encaja.
enum CompanyType {
  RESTAURANT
  CAFE
  BAR
  CULINARY_STUDIO
  CATERING
  HOTEL
  EVENT_VENUE
  PRODUCER
  // Cerveceria, destileria o viñedo: los tres hacen bebida, y separarlos
  // obligaria a elegir entre tres casillas casi iguales.
  BEVERAGE_MAKER
  CULINARY_SCHOOL
  INDEPENDENT_CHEF
  TOUR_OPERATOR
  OTHER
}

enum DocumentType {
  NIT
  CEDULA
  PASAPORTE
  OTHER
}

model Company {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])

  companyName    String
  slug           String        @unique
  // Slugs que esta empresa tuvo antes de renombrarse. El slug sigue al
  // nombre para que la URL sea coherente, pero los enlaces ya compartidos
  // tienen que seguir abriendo el catalogo: un anfitrion no puede perder
  // su trafico por corregir una tilde.
  previousSlugs  String[]      @default([])
  businessName   String?
  description    String?       @db.Text
  companyType    CompanyType?
  companyEmail   String?
  companyPhone   String?
  logo           String? // URL del asset
  documentType   DocumentType?
  documentNumber String?
  // Digito de verificacion del NIT. Se deduce del propio numero, asi que
  // guardarlo es redundante a proposito: es lo que aparece impreso en el RUT y
  // en las facturas ("900.123.456-7"), y tenerlo evita recalcularlo en cada
  // sitio que lo muestre. Solo aplica a NIT, no a cedula ni pasaporte.
  documentDv     String?
  website        String?
  address        Json? // { street, city, state, postalCode, country }
  // Origenes autorizados a insertar el catalogo en un iframe.
  // Lista VACIA = cualquiera puede: es el comportamiento previo y cambiarlo
  // por defecto romperia los embeds que ya estan publicados.
  embedDomains   String[]      @default([])

  // Frase corta de la empresa; sale en su catalogo publico.
  tagline String?

  // Colores de marca del anfitrion, en hexadecimal (#RRGGBB).
  //
  // null = usa los de la plataforma. Se guardan solo los dos que el anfitrion
  // elige; los tonos derivados —el de paso del raton, y si el texto encima va
  // en blanco o en negro— se calculan al pintar, para que no puedan quedar
  // desparejados de su origen.
  //
  // El secundario es decorativo: degradados, etiquetas, banda de portada.
  // Nunca se usa para texto corrido, porque un color elegido a mano puede
  // dejar el catalogo ilegible.
  // Representante legal: quien firma por la empresa.
  //
  // Solo tiene sentido en una persona juridica. Una persona natural se
  // representa a si misma, y pedirselo aparte seria pedirle que repita sus
  // propios datos.
  //
  // Su documento identifica a una PERSONA, asi que del enum DocumentType no
  // aplica NIT y el formulario no lo ofrece. Se reutiliza ese enum en vez de
  // crear uno casi igual, que acabaria desincronizado del primero.
  legalRepName      String?
  legalRepDocType   DocumentType?
  legalRepDocNumber String?

  // Los suyos: a quien escribir en su empresa. `contacts`, mas abajo, son
  // los CLIENTES de su CRM; no confundirlos es medio motivo de este nombre.
  companyContacts CompanyContact[]

  // Actividad economica segun la CIIU Rev. 4 adaptada para Colombia: cuatro
  // digitos. Se guarda solo el codigo y no su descripcion: la descripcion es
  // consecuencia del codigo, y duplicarla dejaria que se contradigan.
  //
  // Sale del RUT, casilla 46. Se admite cualquier codigo de cuatro digitos y
  // no una lista cerrada: la clasificacion la fija la DIAN, cambia sin avisar
  // a nadie, y rechazar el codigo que el anfitrion tiene impreso en su RUT
  // seria decirle que su documento oficial esta mal.
  ciiuCode String?

  // null = todavia no lo ha dicho. Las empresas que ya existian estan asi, y
  // mientras tanto se les piden los dos documentos, que es lo que veian antes.
  personType PersonType?

  // Un negocio rara vez es una sola cosa: un hotel que ademas hace catering,
  // una finca que ademas da clases. El principal es el que manda; el segundo
  // es opcional y no puede repetir al primero.
  companyTypeSecondary CompanyType?

  brandPrimary   String?
  brandSecondary String?

  // Portada del catalogo. NONE deja la cabecera como estaba: solo logo y
  // nombre. Las imagenes valen para IMAGE (la primera) y para SLIDER.
  coverType   CoverType @default(NONE)
  coverImages String[]  @default([])
  coverVideo  String?

  // Id del restaurante en OpenTable (el "rid" de sus enlaces). Es lo unico
  // que OpenTable expone sin contrato de partner, y basta para enlazar su
  // ficha y sus reservas.
  openTableRid String?

  // Operacion. Se leen al crear reservas, no son solo preferencias:
  // autoConfirm decide si una reserva nace confirmada, y blockWhenFull
  // rechaza las que pasarian del aforo de la experiencia.
  autoConfirmReservations Boolean @default(false)
  blockWhenFull           Boolean @default(true)

  // Si hay que pagar para que la reserva valga. null = hereda el valor por
  // defecto de la plataforma; una cena de degustacion puede querer prepago y
  // un recorrido casual no.
  requirePayment Boolean?

  // ──────── Pasarela de pagos propia ────────
  //
  // Cuando esta activa, el cliente le paga DIRECTAMENTE al anfitrion: el
  // dinero no pasa por FILO y por eso FILO no cobra comision sobre esa venta.
  // La del revendedor se sigue devengando, pero cambia de deudor — la debe el
  // anfitrion, que es quien recibio el dinero.
  //
  // Los tres secretos se guardan cifrados. Son credenciales de cobro de un
  // tercero: una copia de la base no puede bastar para cobrar en su nombre.
  paymentProvider        PaymentProvider?
  paymentGatewayEnabled  Boolean            @default(false)
  paymentEnvironment     PaymentEnvironment @default(SANDBOX)
  // Publica por diseño: viaja al navegador para abrir el checkout.
  gatewayPublicKey       String?
  gatewayPrivateKey      String?
  gatewayIntegritySecret String?
  gatewayEventsSecret    String?

  employeeCount String? // enum-like; lo dejamos string para flexibilidad de UI
  annualRevenue String?
  businessYears String?

  // Documentos legales: RUT y certificado de Camara de Comercio.
  //
  // Se guarda la CLAVE de S3, no una URL como en `logo`. Estos ficheros viven
  // en el prefijo privado del bucket, fuera de la politica de lectura publica,
  // asi que no existe una URL estable que servir: el enlace se firma en cada
  // lectura y caduca. Guardar una URL aqui seria guardar algo que da 403.
  rutKey         String?
  rutSubidoEl    DateTime?
  camaraKey      String?
  camaraSubidaEl DateTime?

  users                  User[]           @relation("CompanyUsers")
  locations              Location[]
  menus                  Menu[]
  experiences            Experience[]
  reservations           Reservation[]
  // Reservas que esta empresa vendio como revendedora.
  reservationsAsReseller Reservation[]    @relation("ReservationReseller")
  payouts                Payout[]
  // Las dispersiones que ESTA empresa paga, no las que recibe: con pasarela
  // propia el anfitrion le paga su comision al revendedor.
  payoutsPagados         Payout[]         @relation("PayoutPagador")
  aiAgent                AiAgent?
  aiConversations        AiConversation[]
  channelListings        ChannelListing[]

  // Inverso de PlatformSettings.platformCompany: la empresa que representa
  // a la plataforma. Es una lista por exigencia de Prisma, pero solo puede
  // haber una fila de ajustes, asi que en la practica es cero o una.
  comoPlataforma PlatformSettings[] @relation("EmpresaDeLaPlataforma")
  quotes         Quote[]
  contacts       Contact[]
  crmCompanies   CrmCompany[]
  opportunities  Opportunity[]
  apiKeys        ApiKey[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])

  /// TR-21. Su propia agenda: horarios sin sede ni experiencia.
  ownAvailabilities Availability[] @relation("AvailabilityCompany")
}

model Location {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name         String
  slug         String?
  description  String? @db.Text
  address      Json? // { street, city, state, postalCode, country }
  contactInfo  Json? // { phone, email }
  // Cuanta gente cabe a la vez. Columna propia y no un Json: antes era
  // { minGuests, maxGuests } y el minimo no era de la sede sino de cada
  // experiencia —una sede no tiene un minimo de personas, un evento si—.
  // Quitado el minimo, un Json de una sola clave solo servia para esconderla.
  // Horario semanal de la sede: un tramo por dia.
  //
  // { mon: { isOpen, from, to }, tue: {...}, ... } con las mismas claves de dia
  // que `Availability.weeklySchedule`, para no tener dos vocabularios de dias
  // en la misma base. La forma es mas simple a proposito: alli hay varios
  // tramos por dia porque son huecos de reserva; aqui es cuando abre el local.
  //
  // Que significa depende de si la sede esta abierta al publico: si lo esta es
  // su horario de atencion, y si no, cuando se puede montar algo dentro. El
  // dato es el mismo y guardarlo dos veces solo daria ocasion de que se
  // contradigan.
  openingHours Json?

  // Condiciones que hay que conocer para montar algo aqui: ruido, acceso de
  // proveedores, horarios de montaje, escaleras, catering.
  //
  // Un campo abierto y no veinte casillas mas. Las condiciones de un local son
  // demasiado particulares para anticiparlas, y una lista cerrada obligaria a
  // ampliarla cada vez que aparece una nueva —que es siempre—.
  importantInfo String? @db.Text

  // Lo que la sede ofrece, como lista de claves conocidas.
  //
  // Un array y no una columna booleana por cada cosa: son casillas de una
  // misma pregunta, y añadir "tiene piscina" el dia de mañana seria un
  // despliegue en vez de una migracion. Postgres sabe filtrar por contenido de
  // array, asi que buscar sedes con parqueadero sigue siendo barato.
  amenities String[] @default([])

  // Que incluyen los audiovisuales, en texto libre y corto. Solo tiene sentido
  // si entre las caracteristicas esta la de audiovisuales.
  //
  // NO hay inventario de equipos —dos micros, tres manteles—: eso es otro
  // producto, y una frase resuelve el 90% sin pedirle a nadie que mantenga un
  // almacen al dia.
  avEquipmentDetail String?

  // Cuantos baños tiene.
  bathroomsCount Int?

  // Si la sede esta dividida en salones o funciona como un solo espacio.
  //
  // Se guarda la respuesta y no se deduce de si hay salones: "no tengo
  // salones" es una respuesta dada, y "todavia no he creado ninguno" es otra
  // cosa. Sin este campo no habria forma de distinguirlas, y el formulario
  // volveria a preguntar cada vez.
  hasRooms Boolean?

  rooms Room[]

  // Fotos de la sede, en el orden en que se enseñan. La PRIMERA es la
  // principal: no hay un campo aparte para eso a proposito, porque dos sitios
  // donde decir cual manda acaban diciendo cosas distintas. Marcar una como
  // principal es moverla al frente.
  photos String[] @default([])

  // Video de la sede: solo el enlace, no el archivo. YouTube y Vimeo se
  // incrustan; cualquier otro se enlaza. Alojar video propio es caro y no
  // aporta nada que un enlace no resuelva.
  videoUrl String?

  // Quien responde por esta sede. Sale de los contactos de la empresa, no se
  // vuelve a teclear: sus datos ya estan guardados una vez y copiarlos aqui
  // los condenaria a quedarse viejos.
  //
  // SetNull al borrar el contacto: la sede sigue existiendo y funcionando sin
  // responsable; tumbarla porque alguien salio del equipo seria absurdo.
  responsibleContactId String?
  responsibleContact   CompanyContact? @relation(fields: [responsibleContactId], references: [id], onDelete: SetNull)

  // Donde cae la sede en el mapa. Se calcula de la direccion y el anfitrion
  // puede corregirlo arrastrando el pin, asi que lo guardado manda sobre
  // cualquier recalculo: es un dato dado, no derivado.
  //
  // Van juntos o no van: una latitud sin longitud no ubica nada. Se guardan
  // como dos columnas porque asi se pueden consultar por rango —buscar sedes
  // cerca de un punto— cosa que un Json no deja hacer.
  latitude  Float?
  longitude Float?

  maxCapacity Int?

  // Si es un local abierto al publico o un espacio al que solo se entra con
  // reserva. null = las sedes anteriores a este campo, que no lo declararon:
  // no se asume ninguna de las dos, porque ninguna es mas probable.
  isPublic Boolean?

  isMain Boolean @default(false)

  experiences    Experience[]   @relation("ExperienceLocations")
  availabilities Availability[]
  reservations   Reservation[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([responsibleContactId])
}

// La carta de un anfitrion: que se come en sus experiencias.
//
// Es entidad propia y no texto dentro de la experiencia porque la misma carta
// suele servir para varias: manteniendola en un solo sitio, cambiar un plato
// no obliga a editar cada experiencia donde aparece.
model Menu {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name        String
  slug        String?
  description String? @db.Text

  // Secciones con sus platos, en un solo campo:
  //   [{ name, items: [{ name, description?, price?, image? }] }]
  //
  // Van como JSON y no en tablas propias porque un menu se edita entero de
  // una vez: el orden sale del array y guardar es un solo UPDATE. El precio
  // del plato es informativo y opcional —en un menu de degustacion incluido
  // en la experiencia no pinta nada—, y no entra en el total de la reserva.
  //
  // El precio de esto es que no se puede consultar por plato (buscar un
  // ingrediente, filtrar por alergeno). Si eso hiciera falta, toca sacar
  // secciones y platos a sus propias tablas.
  sections Json?

  // Una carta puede servir a varias experiencias, y una experiencia puede
  // ofrecer varias (la normal y la vegetariana, por ejemplo).
  experiences Experience[] @relation("ExperienceMenus")

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}

enum ExperienceType {
  VIRTUAL
  PRESENTIAL
  HYBRID
}

// Forma en que se expresa una comision: porcentaje del total de la reserva
// o monto fijo por reserva.
enum CommissionType {
  PERCENT
  FIXED
}

// En que calidad se le debe dinero a una empresa. La misma empresa puede
// tener saldo por las dos: como anfitriona por sus experiencias y como
// revendedora por lo que vendio de otros.
enum PayoutRole {
  HOST
  RESELLER
}

// Pasarela con la que cobra un anfitrion por su cuenta.
enum PaymentProvider {
  WOMPI
  MERCADO_PAGO
}

// Aparte de WompiEnvironment, que es de la pasarela de la plataforma: este
// vale para cualquier proveedor y no envejece cuando se sume otro.
enum PaymentEnvironment {
  SANDBOX
  PRODUCTION
}

// A que cuenta entro el dinero de una reserva.
enum CollectedBy {
  PLATFORM
  HOST
}

// Dispersion de fondos: FILO cobra todo y luego paga a cada parte. Cada
// fila es una transferencia ya hecha, y el saldo pendiente sale de restar
// lo dispersado a lo acumulado por reservas pagadas.
model Payout {
  id String @id @default(cuid())

  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  role      PayoutRole

  // Quien paga. NULL = FILO, que era el unico pagador hasta que existieron
  // las pasarelas propias. Con cobro directo el dinero nunca llega a FILO y
  // la comision del revendedor la debe el anfitrion.
  payerCompanyId String?
  payerCompany   Company? @relation("PayoutPagador", fields: [payerCompanyId], references: [id])

  amount    Decimal @db.Decimal(14, 2)
  reference String? // numero de transferencia, comprobante, etc.
  notes     String?

  // Quien lo registro. Sin FK: el historial de pagos debe sobrevivir al
  // borrado del usuario, igual que el de auditoria.
  createdById    String?
  createdByEmail String?

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([companyId, role])
  @@index([payerCompanyId])
  @@index([paidAt])
}

// Ajustes globales de la plataforma. Fila unica (id = "default"): son
// valores que aplican a todo, no por empresa.
model PlatformSettings {
  id String @id @default("default")

  // Comision de Tenemos Filo sobre cada reserva.
  filoCommissionType  CommissionType @default(PERCENT)
  filoCommissionValue Decimal        @default(0) @db.Decimal(12, 2)

  // Comision del revendedor: solo se aplica si la reserva entra por esa via.
  resellerCommissionType  CommissionType @default(PERCENT)
  resellerCommissionValue Decimal        @default(0) @db.Decimal(12, 2)

  // Valor por defecto de "hay que pagar para reservar". Cada empresa puede
  // apartarse de el; esto es solo lo que se aplica si no dice nada.
  //
  // Exigir pago sin pasarela activa dejaria el catalogo sin forma de
  // reservar, asi que solo surte efecto si wompiEnabled esta encendido.
  requirePaymentDefault Boolean @default(false)

  // ──────── Pasarela de pagos (Wompi) ────────
  // Solo el ADMIN configura esto. Las llaves privadas NUNCA salen del API:
  // el GET de ajustes devuelve unicamente si estan puestas.
  wompiEnabled         Boolean          @default(false)
  wompiEnvironment     WompiEnvironment @default(SANDBOX)
  // Publica por diseño: viaja al navegador para abrir el checkout.
  wompiPublicKey       String?
  // Secretos:
  wompiPrivateKey      String?
  wompiIntegritySecret String? // firma los datos del checkout
  wompiEventsSecret    String? // valida los webhooks entrantes

  // ──────── La empresa que representa a la plataforma ────────
  // Filo tambien vende: tiene su propio canal, y las reservas que entran por
  // el se le atribuyen como revendedora. Necesita entonces una empresa
  // propia de la que cuelguen sus claves API y sus liquidaciones.
  //
  // Vive aqui y no como un rol o un flag en Company porque es configuracion
  // de la plataforma: cual de las empresas es "la casa". Los usuarios ADMIN
  // siguen SIN companyId a proposito, para conservar la vista global; media
  // aplicacion filtra por la empresa del usuario cuando la tiene.
  platformCompanyId String?
  platformCompany   Company? @relation("EmpresaDeLaPlataforma", fields: [platformCompanyId], references: [id])

  updatedAt DateTime @updatedAt
}

enum WompiEnvironment {
  SANDBOX
  PRODUCTION
}

enum ExperienceStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  INACTIVE
}

model Experience {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  title              String
  slug               String           @unique
  description        String?          @db.Text
  categories         String[]
  duration           Int? // minutos

  // TR-19. Lo que ocupa la experiencia ademas de si misma.
  //
  // Una cena de tres horas no deja el sitio libre a las tres: hay que montar
  // antes y recoger despues, y en ese rato no cabe otra cosa. La ocupacion
  // real es preparacion + duracion + limpieza, y es lo que se cruza con la
  // agenda del anfitrion.
  //
  // Van en la experiencia y no en el horario a proposito: montar un taller de
  // coctelería no cuesta lo mismo que montar una cata, y es propio de la
  // experiencia, no del dia en que se haga.
  prepTime    Int? // minutos antes
  cleanupTime Int? // minutos despues

  capacity           Int?
  minCapacity        Int?
  basePrice          Decimal?         @db.Decimal(12, 2)
  currency           String           @default("COP")
  featuredImage      String?
  gallery            Json? // string[] de URLs
  experienceType     ExperienceType   @default(PRESENTIAL)
  isVirtual          Boolean          @default(false)
  virtualPlatform    String?
  presentialLocation String?
  presentialAddress  String?
  presentialCity     String?
  // Departamento del lugar puntual. Va con presentialCity porque la ciudad
  // sola no basta: hay municipios con el mismo nombre en varios
  // departamentos, y el selector del panel encadena uno con otro.
  presentialState    String?
  hideAddress        Boolean          @default(false)
  requirements       String?          @db.Text
  includes           Json? // string[] o texto libre
  addons             Json? // [{ name, price, priceType, description }]
  startDate          DateTime?
  endDate            DateTime?
  startTime          String? // formato "HH:mm"
  endTime            String?
  status             ExperienceStatus @default(DRAFT)
  isFeatured         Boolean          @default(false)
  rating             Float?
  totalBookings      Int              @default(0)
  totalRevenue       Decimal          @default(0) @db.Decimal(14, 2)

  locations        Location[]              @relation("ExperienceLocations")
  menus            Menu[]                  @relation("ExperienceMenus")
  availabilities   Availability[]          @relation("ExperienceAvailabilities")
  reservations     Reservation[]
  quotes           Quote[]                 @relation("QuoteExperiences")
  opportunityItems OpportunityExperience[]
  channelListings  ChannelListing[]

  // Comisiones. Null = hereda el valor por defecto de PlatformSettings.
  // Solo un ADMIN puede fijarlas: un anfitrion no se pone su propia comision.
  filoCommissionType      CommissionType?
  filoCommissionValue     Decimal?        @db.Decimal(12, 2)
  resellerCommissionType  CommissionType?
  resellerCommissionValue Decimal?        @db.Decimal(12, 2)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([status])

  /// TR-14. Las opciones de cotizacion que la ofrecen.
  quoteOptions QuoteOption[] @relation("QuoteOptionExperience")
}

model Availability {
  id          String  @id @default(cuid())
  name        String
  description String?

  // TR-21. De quien es este horario.
  //
  // Hasta ahora un horario solo existia colgado de una sede o de una
  // experiencia, asi que la agenda PROPIA del anfitrion no se podia expresar:
  // un cocinero que va a casa del cliente no tiene sede, y su calendario no
  // es de ninguna experiencia en particular — es el suyo.
  //
  // Sin sede y sin experiencias, este horario ES la agenda del anfitrion y
  // vale para todo lo que no tenga el suyo.
  companyId String?
  company   Company? @relation("AvailabilityCompany", fields: [companyId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  experiences Experience[] @relation("ExperienceAvailabilities")

  isMain         Boolean  @default(false)
  weeklySchedule Json // { mon:{isActive,timeSlots[]}, tue:{...}, ... }

  // TR-35. Desde y hasta cuando se repite este horario.
  //
  // Un horario semanal sin fecha de corte genera inventario para siempre: en
  // 2031 se puede reservar un sabado que nadie ha decidido abrir. Con esto, la
  // reagenda existe mientras el anfitrion dijo que existe.
  //
  // `validUntil` nulo significa "sin fecha final" y es el caso de los
  // horarios creados antes de esta regla. Los nuevos la piden.
  validFrom  DateTime?
  validUntil DateTime?
  bufferTime     Int      @default(0) // minutos entre reservas
  // TR-06. Cuanta anticipacion necesita el anfitrion, EN HORAS.
  //
  // En horas y no en minutos —el comentario decia otra cosa y nadie lo leia,
  // porque hasta ahora este campo no se usaba— porque es como lo piensa quien
  // lo rellena: "con un dia de aviso" son 24, no 1440.
  minimumNotice  Int      @default(0)
  blockedDates   String[] // ISO dates "YYYY-MM-DD"
  notes          String?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  QUALIFIED
  UNQUALIFIED
  ARCHIVED
}

model Contact {
  id            String  @id @default(cuid())
  hostCompanyId String
  hostCompany   Company @relation(fields: [hostCompanyId], references: [id])

  firstName  String
  lastName   String?
  email      String?
  phone      String?
  mobile     String?
  jobTitle   String?
  department String?

  crmCompanyId String?
  crmCompany   CrmCompany? @relation(fields: [crmCompanyId], references: [id])

  // Pidio no recibir seguimiento comercial. No se le crean seguimientos y los
  // que tuviera pendientes dejan de aplicar. Es una peticion suya, no un
  // estado del negocio, y por eso va aparte de `status`.
  doNotContact Boolean @default(false)

  contactType String?
  status      ContactStatus @default(ACTIVE)
  source      String?
  address     Json?
  avatar      String?
  notes       String?       @db.Text
  tags        String[]
  socialMedia Json? // { linkedin, twitter, facebook, instagram }

  assignedToId String?
  assignedTo   User?   @relation("ContactAssignedTo", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?   @relation("ContactCreatedBy", fields: [createdById], references: [id])

  lastContactDate DateTime?
  nextFollowUp    DateTime?

  decisionForOpportunities Opportunity[]    @relation("OpportunityDecisionMakers")
  opportunities            Opportunity[]
  aiConversations          AiConversation[]
  reservations             Reservation[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([hostCompanyId])
  @@index([crmCompanyId])
}

model CrmCompany {
  id            String  @id @default(cuid())
  hostCompanyId String
  hostCompany   Company @relation(fields: [hostCompanyId], references: [id])

  companyName    String
  businessName   String?
  companyType    String?
  industry       String?
  description    String?  @db.Text
  email          String?
  phone          String?
  website        String?
  documentType   String?
  documentNumber String?
  address        Json?
  employeeCount  String?
  annualRevenue  String?
  logo           String?
  status         String?
  source         String?
  notes          String?  @db.Text
  tags           String[]
  socialMedia    Json?

  assignedToId String?
  assignedTo   User?   @relation("CrmCompanyAssignedTo", fields: [assignedToId], references: [id])

  lastContactDate DateTime?
  nextFollowUp    DateTime?

  contacts      Contact[]
  opportunities Opportunity[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([hostCompanyId])
}

// Que clase de experiencia se esta vendiendo. Es la PRIMERA decision de una
// solicitud: de ella dependen el tipo de comprador, si puede haber pre-reserva
// y que hace falta para dar la venta por cerrada.
// Que seguimiento es. El momento en que nace lo dice todo: los LEAD_* cuentan
// desde que entro la solicitud, PROPUESTA desde que el cliente recibio algo.
enum FollowupKind {
  LEAD_24H
  LEAD_48H
  LEAD_72H
  // La propuesta sin respuesta, en tres tiempos: a las 48 h, al tercer dia y
  // al septimo. Tres recordatorios y se para: a partir de ahi insistir ya no
  // es seguimiento.
  PROPUESTA
  PROPUESTA_3D
  PROPUESTA_7D
  // El cobro de una pre-reserva. Se crea al mandar los medios de pago y no
  // se va hasta que la venta se confirme o se pierda: una pre-reserva olvidada
  // tiene un espacio bloqueado sin nada a cambio.
  PAGO_PENDIENTE
}

// PENDIENTE es trabajo por hacer; HECHO, trabajo hecho; NO_APLICA es lo que
// dejo de tener sentido —el cliente ya respondio, la venta se cerro, pidio no
// ser contactado—. Se distingue de HECHO a proposito: uno mide gestion y el
// otro solo limpia la lista.
enum FollowupStatus {
  PENDIENTE
  HECHO
  NO_APLICA
}

enum ExperienceKind {
  ABIERTA
  PRIVADA
}

// A quien se le vende. Clasifica al COMPRADOR, no a la experiencia: una
// experiencia abierta siempre se le vende a un particular, y una privada puede
// venderse a un particular o a una empresa.
enum BuyerKind {
  SOCIAL
  CORPORATIVO
}

// De donde salio el lead. RESELLER y REFERIDO admiten decir cual, en
// `leadSourceDetail`; los demas no lo necesitan.
enum LeadSource {
  WHATSAPP
  INSTAGRAM
  WEB
  REFERIDO
  PROSPECCION
  RESELLER
  OTRO
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  APPROVAL
  CLOSED_WON
  CLOSED_LOST
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  PAUSED
}

model Opportunity {
  id   String @id @default(cuid())
  name String

  hostCompanyId String
  hostCompany   Company @relation(fields: [hostCompanyId], references: [id])

  crmCompanyId String?
  crmCompany   CrmCompany? @relation(fields: [crmCompanyId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // La clasificacion comercial de la solicitud. Nullable porque las
  // oportunidades anteriores a esto no la tienen y no se les inventa.
  experienceKind ExperienceKind?
  buyerKind      BuyerKind?

  // De donde salio, y cual cuando es referido o revendedor.
  leadSource       LeadSource?
  leadSourceDetail String?

  followups Followup[]

  // Cuando el cliente recibio lo que necesitaba para decidir: la cotizacion en
  // una privada, el enlace de catalogo en una abierta. Es lo que convierte la
  // oportunidad en "Propuesta enviada", y de aqui colgara el seguimiento.
  proposalSentAt DateTime?

  // Cuando se le mandaron los medios de pago. Es lo que convierte la solicitud
  // en pre-reserva y arranca el seguimiento del cobro.
  paymentInstructionsSentAt DateTime?

  // Una condicion de pago distinta al abono, acordada y autorizada: una orden
  // de compra, por ejemplo. Se guarda el texto de lo acordado y quien lo
  // autorizo, porque saltarse el abono minimo tiene que dejar rastro.
  paymentConditionNote String?
  paymentConditionById String?
  paymentConditionBy   User?   @relation("OpportunityPaymentCondition", fields: [paymentConditionById], references: [id])

  // El enlace de reserva que se le paso al cliente. Se guarda un token y no
  // se ponen sus datos en la URL: el motor publico canjea el token por lo
  // que ya sabemos de el, asi que el enlace no lleva nada legible encima.
  bookingToken   String?   @unique
  bookingTokenAt DateTime?

  reservations    Reservation[]
  aiConversations AiConversation[]

  stage             OpportunityStage  @default(PROSPECTING)
  status            OpportunityStatus @default(OPEN)
  value             Decimal           @default(0) @db.Decimal(14, 2)
  currency          String            @default("COP")
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  description       String?           @db.Text
  lostReason        String?
  lostReasonNotes   String?           @db.Text
  wonReason         String?
  source            String?

  assignedToId String?
  assignedTo   User?   @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?   @relation("OpportunityCreatedBy", fields: [createdById], references: [id])

  notes String?  @db.Text
  tags  String[]

  experiences    OpportunityExperience[]
  decisionMakers Contact[]               @relation("OpportunityDecisionMakers")
  quotes         Quote[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([hostCompanyId])
  @@index([stage])
}

// Pivote Opportunity <-> Experience con datos extra (cantidad, precio custom)
model OpportunityExperience {
  id            String   @id @default(cuid())
  opportunityId String
  experienceId  String
  quantity      Int      @default(1)
  customPrice   Decimal? @db.Decimal(12, 2)
  notes         String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  experience  Experience  @relation(fields: [experienceId], references: [id])

  @@unique([opportunityId, experienceId])
}

// Por donde se le hizo llegar la propuesta al cliente. EXTERNO cubre el caso
// real de mandarla por WhatsApp o por el correo propio: el estado comercial
// tiene que poder reflejarlo aunque FILO no la haya enviado.
enum QuoteChannel {
  FILO
  EXTERNO
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

/// TR-14. Una de las (hasta tres) opciones de una cotizacion.
///
/// Cada una lleva sus propios datos porque eso es lo que las distingue: otra
/// fecha, otra experiencia, otro precio. Guardarlas como texto en las notas
/// —que es lo que se hacia— significaba que el calendario no sabia de ellas y
/// que aceptar una habia que teclearla a mano.
model QuoteOption {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// En que orden se le presentan. 1, 2, 3.
  position Int @default(1)

  /// Como se le llama al cliente: "Opcion A: terraza", "Plan economico".
  label String?

  experienceId String?
  experience   Experience? @relation("QuoteOptionExperience", fields: [experienceId], references: [id])

  eventDate DateTime?
  eventTime String?
  guests    Int?

  /// El precio de ESTA opcion. Nulo = el de la experiencia por el numero de
  /// personas; con valor, manda lo acordado.
  total Decimal? @db.Decimal(12, 2)

  notes String? @db.Text

  /// Cuando el cliente la eligio. Varias pueden estar elegidas a la vez: un
  /// corporativo que acepta dos opciones compra dos cenas.
  chosenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quoteId, position])
  @@index([quoteId])
}

model Quote {
  id            String    @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String?
  eventDate     DateTime?
  eventTime     String?
  guests        Int?
  location      String?
  notes         String?   @db.Text

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  hostId String?
  host   User?   @relation("QuoteHost", fields: [hostId], references: [id])

  // De que oportunidad sale. Sin esto la cotizacion vivia suelta y habia que
  // volver a teclear lo que ya estaba en la solicitud.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  // Version dentro de su oportunidad: 1, 2, 3... Una oportunidad puede tener
  // varias cotizaciones y todas se conservan; no se pisan.
  version Int @default(1)

  // Cuando se envio al cliente, y por donde. Crear una cotizacion y enviarla
  // son dos cosas distintas: se puede armar una y no mandarla nunca.
  //
  // La VIGENTE es la enviada de version mas alta. No hay un campo que lo
  // marque a proposito: seria un segundo sitio donde decir cual manda, y dos
  // sitios acaban diciendo cosas distintas.
  sentAt  DateTime?
  sentVia QuoteChannel?

  status QuoteStatus @default(PENDING)

  experiences Experience[] @relation("QuoteExperiences")

  /// TR-14. Las opciones que se le ponen al cliente sobre la mesa.
  ///
  /// Hasta tres, y simultaneas: no son versiones de la cotizacion —eso ya
  /// existe y es otra cosa, el historial de lo que se le fue mandando— sino
  /// alternativas vivas a la vez entre las que elige. "El sabado 12 en la
  /// terraza, el domingo 13 en el salon, o el sabado 19 mas barato."
  ///
  /// Una cotizacion puede producir VARIAS reservas: un corporativo que acepta
  /// dos de las tres opciones compra dos cenas, no una.
  options QuoteOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([opportunityId])
}

/// Los cinco estados de una reserva (TR-08).
///
/// PENDING es la que esta comprometida pero no cobrada, y bloquea el recurso
/// igual que una confirmada: el conteo de aforo excluye solo CANCELLED y
/// NO_SHOW. Ahi vive la antigua "pre-reserva" de una privada (TR-01), que no
/// necesitaba un estado propio: era lo mismo contado dos veces.
///
/// Reagendar NO es un estado, es un hecho que le pasa a una reserva que sigue
/// viva: queda en `rescheduling` y en su aviso, y el estado no se mueve. Como
/// estado obligaba a elegir entre decir "esta confirmada" y decir "la
/// movieron", cuando las dos cosas son ciertas a la vez.
enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIAL
  FAILED
}

enum ClientType {
  GUEST
  REGISTERED
}

/// Como se CREO la reserva. Es historia de la operacion, no comercial.
enum ReservationSource {
  MANUAL
  BOOKING_ENGINE
  QUOTE
}

/// TR-04. El canal por el que entro la venta.
///
/// Distinto del origen del lead (`Opportunity.leadSource`), que dice de donde
/// salio el contacto: una persona puede llegar por Instagram y acabar
/// comprando por el catalogo, y son dos hechos distintos que hay que poder
/// mirar por separado.
///
/// Este es el eje que decide la comisionabilidad, y por eso es un valor tipado
/// y guardado: antes se deducia de `source` mas "tiene revendedor", es decir
/// de dos campos que hablaban de otra cosa, y cualquier cambio en como se crea
/// una reserva movia sin querer a quien se le cobra.
enum SalesChannel {
  /// Lo cargo el anfitrion a mano. No genera fee: no paso por FILO.
  MANUAL
  /// El catalogo publico del propio anfitrion.
  CHECKOUT
  /// El catalogo o el API de un revendedor conectado.
  RESELLER
  /// El enlace de reserva que el anfitrion mando desde una oportunidad.
  CRM
}

model Reservation {
  id                String @id @default(cuid())
  reservationNumber String @unique

  // TR-43. La clave que manda quien vende para que un reintento no venda dos
  // veces. Unica en toda la tabla: si el canal repite la llamada por un
  // timeout, la segunda devuelve esta misma reserva en vez de crear otra,
  // descontar otro cupo y generar otro fee.
  //
  // Opcional porque no todo el mundo la manda. Quien no la mande asume que un
  // reintento suyo crea una reserva nueva.
  idempotencyKey String? @unique

  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Empresa revendedora que hizo la venta, si la hubo. Sin esto se cobra la
  // comision de revendedor pero no se sabe a quien hay que pagarsela.
  resellerCompanyId String?
  resellerCompany   Company? @relation("ReservationReseller", fields: [resellerCompanyId], references: [id])

  client     Json // { name, email, phone }
  clientType ClientType @default(GUEST)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  source          ReservationSource @default(MANUAL)

  /// TR-04. El canal por el que entro esta venta, congelado al crearla.
  ///
  /// De el depende si genera fee. Se guarda y no se deduce porque deducirlo
  /// significaba leer `source` y `resellerCompanyId`, dos campos que hablan de
  /// otras cosas: el dia que cambie como se crea una reserva, cambiaria sin
  /// querer a quien se le cobra comision.
  channel         SalesChannel      @default(MANUAL)
  reservationDate DateTime
  duration        Int? // minutos
  participants    Int
  status          ReservationStatus @default(PENDING)
  paymentStatus   PaymentStatus     @default(PENDING)

  // Cuanto se ha recibido de verdad. `paymentStatus` dice si esta pagada o no;
  // esto dice cuanto, que es lo unico que permite comprobar un abono parcial.
  paidAmount Decimal @default(0) @db.Decimal(14, 2)

  // Quien cobro esta reserva. Se congela al crearla y NO se deduce despues de
  // la empresa: un anfitrion conecta y desconecta su pasarela cuando quiere, y
  // si esto se recalculara, una reserva vieja cambiaria de dueño el dia que el
  // toque un ajuste. Lo que importa es quien cobro ese dia.
  collectedBy CollectedBy @default(PLATFORM)

  // Los datos de facturacion tal y como estaban al venderse: razon social,
  // documento y direccion. Se congelan aqui porque la empresa del CRM cambia
  // y una factura se emite contra lo que era cierto ese dia.
  billingData Json?

  // De que oportunidad salio, si salio de una. Las reservas que entran por el
  // catalogo publico no tienen oportunidad detras.
  opportunityId       String?
  opportunity         Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  pricing             Json // { basePrice, subtotal, addons[], addonsTotal, discount, tax, commission, total, hostEarnings }
  paymentMethod       String?
  paymentDetails      Json?
  locationId          String?
  location            Location?    @relation(fields: [locationId], references: [id])
  isVirtual           Boolean      @default(false)
  virtualDetails      String?
  specialRequirements String?      @db.Text
  cancellation        Json? // { cancelledAt, cancelledBy, cancellationReason, refundAmount, refundStatus }

  // TR-09 y TR-25. Cuanta gente aparecio de verdad.
  //
  // Es distinto de `participants`, que es lo vendido: de diez reservados
  // pueden venir ocho. Hace falta para dos cosas que el documento pide por
  // separado: cerrar la experiencia con la asistencia registrada, y poder
  // reportarsela al canal que vendio esa reserva.
  //
  // Null mientras no se haya cerrado: no se presume que vinieron todos.
  attendedCount Int?

  // TR-26. El contacto del CRM del anfitrion al que corresponde el comprador.
  //
  // Existe porque una venta de revendedor tiene que dejarle al anfitrion el
  // cliente: antes el comprador vivia solo dentro del JSON `client` de la
  // reserva y no llegaba al CRM, asi que el anfitrion vendia y no se quedaba
  // con nadie a quien volver a venderle.
  //
  // Opcional: una venta sin correo ni telefono no se puede cruzar con nadie
  // sin arriesgarse a confundir a dos personas.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // TR-39. El historial de cambios de esta reserva.
  //
  // Una reserva editada o reagendada sigue siendo la misma —mismo id, mismo
  // numero— y eso solo sirve de algo si se puede ver que le fue pasando. Sin
  // esto, "la movieron dos veces y al final se cayo" no se podia reconstruir.
  //
  // Cada entrada: { fecha, quien, email, campo, antes, despues, motivo }.
  changes Json[] @default([])

  // TR-12. Cargos adicionales acordados despues de vender.
  //
  // Van aparte del precio porque el precio original NO se recalcula: lo
  // vendido es lo vendido, y un cambio de fecha o de cantidad no mueve el
  // dinero por su cuenta. Lo que se cobra de mas se apunta aqui y suma.
  //
  // Cada entrada: { id, fecha, importe, concepto, estado }.
  extraCharges Json[] @default([])

  // TR-30. Los reembolsos de esta reserva, totales o parciales, en un solo
  // sitio. Antes vivian repartidos —uno dentro de `cancellation` y otro
  // dentro de cada baja parcial— y no habia forma de preguntar "cuanto se le
  // ha devuelto a esta reserva" sin mirar en dos formatos distintos.
  //
  // Cada entrada: { id, fecha, importe, motivo, origen, estado, pagadoEl }.
  // `origen` dice de donde vino: CANCELACION, BAJA_PARCIAL o AJUSTE.
  refunds Json[] @default([])

  // TR-07. Las bajas parciales: dos de las diez personas se caen y los otros
  // ocho siguen viniendo. Es una lista y no un campo porque pueden caerse en
  // tandas, y cada una tiene su propio reembolso que alguien tiene que pagar.
  //
  // Cada entrada: { fecha, personas, canceladaPor, motivo, reembolso,
  // estadoDelReembolso }.
  partialCancellations Json[] @default([])

  rescheduling        Json? // { originalDate, newDate, reason, requestedBy }
  /// La nota que le pone el ANFITRION al cerrar la experiencia: como le fue a
  /// el. Es suya y nadie mas la ve.
  rating              Int?

  /// TR-24. Las estrellas que pone el COMENSAL, en cuatro cosas distintas:
  /// experiencia general, servicio, ubicacion y comida.
  ///
  /// Cuatro y no una porque son cuatro decisiones distintas del anfitrion: un
  /// sitio incomodo con comida excelente no se arregla igual que lo contrario,
  /// y una nota unica no dice cual de las dos pasa.
  ///
  /// Sin comentarios ni fotos a proposito (§7 del documento): moderar texto de
  /// desconocidos es un producto en si mismo.
  ///
  /// { general, servicio, ubicacion, comida, fecha }
  ratings             Json?

  /// Con que enlace puede calificar quien vino.
  ///
  /// Un token opaco y de un solo uso, no el numero de reserva: el enlace va
  /// por correo, se reenvia y acaba en sitios que nadie previo. Se genera solo
  /// cuando la experiencia se cierra con asistencia > 0, que es cuando hay
  /// algo que calificar.
  ratingToken         String?   @unique
  ratingRequestedAt   DateTime?
  notes               String?      @db.Text

  // Codigo que el cliente enseña al llegar y el anfitrion valida.
  //
  // Es lo que hace que pasar por FILO no sea opcional para un canal: una
  // venta que no entro aqui no tiene codigo valido, y el anfitrion se entera
  // en la puerta en vez de nunca. Va aparte del numero de reserva a
  // proposito: ese lleva la hora dentro y solo tres caracteres al azar, asi
  // que se puede adivinar; este no.
  confirmationCode String?   @unique
  checkedInAt      DateTime?
  checkedInById    String?
  checkedInBy      User?     @relation("ReservationCheckedInBy", fields: [checkedInById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([resellerCompanyId])
  @@index([checkedInAt])
  @@index([experienceId])
  @@index([status])
  @@index([reservationDate])
  @@index([opportunityId])
  @@index([collectedBy])
}

enum IntegrationType {
  GOOGLE
  OUTLOOK
  ZOHO
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  ERROR
}

model Integration {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation(fields: [userId], references: [id])
  type   IntegrationType
  name   String?
  status IntegrationStatus @default(PENDING)
  config Json? // tokens, calendar IDs, etc. (cifrar a futuro)
  error  String?

  lastSync DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, type])
}

// ============================================================
// API Keys para integraciones externas (server-to-server).
// Una key pertenece a una Company y la creo un host de esa company.
// El token plano solo se devuelve al momento de crear; en DB se guarda
// el hash sha256. `scopes` controla que endpoints puede llamar la key.
// ============================================================

/// Cuanto se usa cada API key, por dia.
///
/// Una fila por key y dia en vez de una por peticion: lo que hace falta es
/// ver el patron —quien lee mucho catalogo y vende poco por aqui—, no
/// auditar llamada a llamada. Guardar cada peticion de un canal activo
/// serian millones de filas para responder la misma pregunta.
model ApiKeyUsage {
  id String @id @default(cuid())

  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  /// El dia, a medianoche UTC.
  dia DateTime @db.Date

  lecturas   Int @default(0)
  escrituras Int @default(0)

  /// Reservas creadas: las ventas que SI entraron por aqui.
  reservas Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([apiKeyId, dia])
  @@index([dia])
}

model ApiKey {
  id      String   @id @default(cuid())
  name    String
  prefix  String   @unique // "tf_live_<8 chars>" visible para identificar la key
  keyHash String   @unique // sha256(token) en hex
  scopes  String[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  uso ApiKeyUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([createdById])
}

// Rastro de quien cambio que. Se escribe desde el middleware de auditoria,
// una fila por mutacion con exito.
//
// No tiene relacion (FK) con User a proposito: el historial debe sobrevivir
// al borrado del usuario que lo genero, que es justo cuando mas importa.
/// TR-44. Un cobro que llego sin una reserva a la que colgarse.
///
/// El requisito dice que ningun cobro puede quedar sin reserva. Pasa poco,
/// pero pasa: la reserva se borro entre el pago y la notificacion, o la
/// pasarela manda una referencia que no reconocemos. Antes eso era una linea
/// en el log que nadie iba a leer, y el dinero quedaba cobrado sin que
/// existiera nada que lo explicara.
///
/// Esto no es contabilidad: es una bandeja de anomalias para que alguien
/// devuelva ese dinero o encuentre a quien pago.
model OrphanPayment {
  id String @id @default(cuid())

  /// WOMPI | MERCADO_PAGO
  gateway       String
  /// La referencia que mando la pasarela: deberia ser un numero de reserva.
  reference     String
  transactionId String?
  amount        Decimal? @db.Decimal(14, 2)
  currency      String?
  /// El estado tal como lo dijo la pasarela, sin traducir.
  gatewayStatus String?

  /// La empresa, cuando se pudo deducir de la pasarela que recibio el evento.
  companyId String?

  /// El evento entero. Es lo unico que permite reconstruir que paso cuando
  /// alguien lo revise semanas despues.
  event Json

  /// Lo miro alguien y lo dejo resuelto —devuelto, reconciliado, descartado.
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  notes      String?   @db.Text

  createdAt DateTime @default(now())

  @@index([resolved])
  @@index([reference])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  // Quien: se copian email y rol al momento del hecho, no se resuelven
  // despues, para que el registro no cambie si el usuario cambia de rol.
  actorId    String?
  actorEmail String?
  actorRole  String?

  // Empresa sobre la que se actuo. Para un ADMIN usando el selector, es la
  // empresa "actuando como"; para el resto, la suya.
  companyId String?

  action       String // CREATE | UPDATE | DELETE
  resourceType String // companies, users, experiences, ...
  resourceId   String?

  method  String
  path    String
  status  Int
  payload Json? // body de la peticion, con secretos redactados

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([companyId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  // sha256(token) en hex. El token plano solo existe en el correo que
  // recibe el usuario: si se filtra la BD, no sirve para resetear nada.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime? // un token es de un solo uso
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Distribucion en canales externos ──────────────────────────────────────

enum CoverType {
  NONE
  IMAGE
  VIDEO
  SLIDER
}

enum ChannelType {
  OPENTABLE
}

enum ChannelListingStatus {
  // Faltan datos obligatorios del canal.
  DRAFT
  // La ficha esta completa y se puede cargar en el canal.
  READY
  // El anfitrion confirmo que ya esta publicada alli.
  PUBLISHED
  // Estuvo publicada y se retiro.
  UNPUBLISHED
}

// Presencia de una experiencia en un canal externo.
//
// No guarda la ficha: se genera desde la experiencia cada vez, para que
// editar la experiencia no deje el canal mostrando datos viejos. Aqui solo
// vive lo que el canal sabe y FILO no: donde quedo publicada y desde cuando.
model ChannelListing {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id])

  channel ChannelType
  status  ChannelListingStatus @default(DRAFT)

  // URL de la ficha en el canal, cuando el anfitrion la publica.
  externalUrl String?
  // Id en el canal, si el canal lo expone.
  externalId  String?
  publishedAt DateTime?
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Una experiencia no puede estar dos veces en el mismo canal.
  @@unique([experienceId, channel])
  @@index([companyId, channel])
}

// ─── Notificaciones ────────────────────────────────────────────────────────

enum NotificationType {
  NEW_RESERVATION
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  RESERVATION_RESCHEDULED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  SYSTEM
}

// Aviso dirigido a una persona concreta.
//
// El texto se guarda ya escrito, no se compone al leerlo: si mañana cambia
// el nombre de una experiencia, la notificacion debe seguir contando lo que
// paso entonces, no reescribir la historia.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String           @db.Text

  read   Boolean   @default(false)
  readAt DateTime?

  // A donde lleva al pulsarla: id de la reserva, de la experiencia...
  data Json?

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Contactos de la empresa: a quien escribir para cada asunto.
//
// No confundir con Contact, que son los CLIENTES del anfitrion en su CRM.
// Estos son suyos: su gente, la que atiende reservas o lleva la contabilidad.
//
// Una empresa de una sola persona puede repetir sus propios datos en los dos;
// no se impide, porque es el caso normal de un chef independiente.
model CompanyContact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type CompanyContactType

  // Solo para OTRO: como se llama ese contacto ("Operaciones", "Prensa").
  // Los dos obligatorios ya se llaman por su tipo.
  label String?

  name     String
  email    String
  phone    String?
  position String?

  // Sedes de las que es responsable. Puede serlo de varias.
  sedesACargo Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, type])
}

// Un salon dentro de una sede: el Principal, la Terraza, el Reservado.
//
// Deliberadamente simple. NO se guardan capacidades por montaje —auditorio,
// coctel, escuela, imperial— ni planos: eso es otro producto, y meterlo aqui
// sin necesitarlo llenaria el formulario de campos que nadie rellena.
model Room {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  maxCapacity Int

  // Mismo criterio que en la sede: la primera es la principal.
  photos String[] @default([])

  // Un salon en obra o fuera de servicio se desactiva; borrarlo se llevaria
  // por delante su historia.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
}

// Un seguimiento comercial: recordar que hay que volver a escribirle a alguien.
//
// Se crean solos —al entrar la solicitud y al enviar la propuesta— justamente
// para que nadie tenga que crearlos a mano, que es la forma segura de que no
// existan.
model Followup {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  kind   FollowupKind
  // Cuando toca hacerlo. Se guarda calculado y no se deduce al leer para que
  // la lista de pendientes sea una consulta simple y no una cuenta por fila.
  dueAt  DateTime
  status FollowupStatus @default(PENDIENTE)

  doneAt DateTime?
  notes  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un mismo seguimiento no se crea dos veces por la misma oportunidad.
  @@unique([opportunityId, kind])
  // Para la lista de pendientes, que es la consulta que se hace todo el rato.
  @@index([opportunityId])
  @@index([status, dueAt])
}

/// El agente de IA de un anfitrion, conectado a su WhatsApp.
///
/// En su propia tabla y no en Company por una razon practica: son quince
/// campos que solo interesan a quien enciende el agente, y meterlos en Company
/// obliga a cargarlos en cada lectura de empresa que hace media aplicacion.
model AiAgent {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  enabled       Boolean @default(false)
  /// Como se presenta al cliente.
  nombre        String  @default("Asistente")
  /// Como habla: cercano, formal, breve. Va al prompt tal cual.
  tono          String?
  /// Lo que el anfitrion quiere que diga y que no. Es lo que lo hace suyo.
  instrucciones String? @db.Text

  /// Que puede hacer ademas de responder. Nunca confirma ni cobra: eso no es
  /// un ajuste, es una linea que el agente no cruza.
  puedeCrearSolicitud Boolean @default(true)
  puedeEnviarEnlace   Boolean @default(true)

  /// WhatsApp Cloud API, con las credenciales del propio anfitrion. Los tres
  /// secretos van cifrados: con ellos se escribe a sus clientes en su nombre.
  waPhoneNumberId String?
  /// El numero visible, solo para que reconozca cual conecto.
  waNumero        String?
  waAccessToken   String?
  waVerifyToken   String?
  waAppSecret     String?

  /// Tope de respuestas al mes. El consumo del modelo lo paga FILO, y sin
  /// tope un bucle de mensajes se lleva la factura por delante.
  mensajesPorMes Int     @default(500)
  mensajesUsados Int     @default(0)
  /// "2026-10". Cuando cambia, el contador vuelve a cero solo.
  mesDelConteo   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([waPhoneNumberId])
}

/// Un hilo con una persona. Se guarda entero: el anfitrion tiene que poder
/// leer que le dijo su agente a un cliente, y sin eso encenderlo es firmar en
/// blanco.
model AiConversation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  canal        String  @default("WHATSAPP")
  telefono     String
  nombrePerfil String?

  /// A quien resulto ser, y que solicitud se abrio. Se llenan cuando el
  /// agente lo averigua, no antes.
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  /// Para que el anfitrion pueda tomar el hilo sin apagar todo el agente.
  pausada Boolean @default(false)

  mensajes AiMessage[]

  ultimoMensajeAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, canal, telefono])
  @@index([companyId, ultimoMensajeAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// CLIENTE, AGENTE o SISTEMA.
  rol         String
  texto       String  @db.Text
  /// Que herramienta uso en ese turno, si uso alguna: es lo que permite
  /// entender despues por que contesto lo que contesto.
  herramienta String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
