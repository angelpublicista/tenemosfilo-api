# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# ──────── Postgres ────────
# A cual base apuntan el servidor Y la CLI de Prisma: local | production
# Default 'local': arrancar sin configurar nada nunca debe pegarle a produccion.
DB_TARGET=local

# Base de desarrollo. Crearla con: npm run db:local:setup
DATABASE_URL_LOCAL="postgresql://TU_USUARIO@localhost:5432/tenemosfilo_dev"

# Importante: incluir ?sslmode=require para conexiones a RDS en produccion
DATABASE_URL_PRODUCTION=""

# DATABASE_URL (opcional): si se define, gana sobre DB_TARGET. Es lo que
# inyectan los deploys. En local dejala sin definir.
# DATABASE_URL=""

# JWT compartido con NextAuth (mismo secreto en el front y el API)
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo"

# Google OAuth (mismos credentials que el front)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# CORS - origenes permitidos del frontend (separados por coma)
CORS_ORIGIN="http://localhost:3000"

# ==========================================
# Correo transaccional (Brevo)
# ==========================================
# Necesario para la recuperacion de contraseña. Si faltan, /auth/forgot-password
# sigue respondiendo 204 pero no envia nada (queda registrado en el log).
# API key en: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@tenemosfilo.com"

# URL publica del front: se usa para armar el enlace del correo
# {APP_URL}/reset-password?token=...
APP_URL="http://localhost:3000"

# ==========================================
# AWS S3 (uploads de imagenes)
# ==========================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Opcional: si pones CloudFront u otro dominio, ej "https://cdn.tenemosfilo.com"
# Si lo dejas vacio, las URLs publicas seran https://{bucket}.s3.{region}.amazonaws.com/{key}
S3_PUBLIC_URL_BASE=""
# Limite por archivo (10 MB por defecto)
UPLOADS_MAX_BYTES=10485760

# Cuantos proxies hay delante del API (Nginx, balanceador, Railway...).
# En local 0. Con un proxy delante, 1. Si se deja en 0 habiendo proxy, el
# limite de peticiones por IP cuenta a todos los visitantes como uno solo.
TRUST_PROXY=0
